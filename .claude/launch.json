{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 5000
    },
    {
      "name": "miniapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "miniapp", "run", "dev"],
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 5174
    },
    {
      "name": "miniapp-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "miniapp", "run", "dev", "--", "--port", "5183", "--strictPort"],
      "port": 5183
    },
    {
      "name": "backend-nobot",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "process.chdir('backend'); process.env.BOT_TOKEN=''; require(require('path').resolve('src/index.js'))"],
      "port": 5000
    },
    {
      "name": "admin-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev", "--", "--port", "5184", "--strictPort"],
      "port": 5184
    }
  ]
}
